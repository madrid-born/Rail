# Browser development uses Vite's /api proxy to https://localhost:7130.
# Bundled MAUI builds default to https://localhost:7130 for Windows development.
# Set this before building for a deployed API (omit the trailing /api).
# VITE_API_BASE_URL=https://your-rail-api.example.com

# The OpenFreeMap basemap needs no account or API key.

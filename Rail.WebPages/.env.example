# Browser development uses Vite's /api proxy to https://localhost:7130.
# Bundled MAUI builds default to https://localhost:7130 for Windows development.
# Set this before building for a deployed API (omit the trailing /api).
# VITE_API_BASE_URL=https://your-rail-api.example.com

# Installed MAUI apps always use bundled offline maps (no map host required).
# Browser/Vue Dev maps default to VITE_API_BASE_URL + /api/maps.
# Optional separate browser map host on Ubuntu; include the directory path.
# VITE_MAP_BASE_URL=https://your-rail-api.example.com/api/maps
